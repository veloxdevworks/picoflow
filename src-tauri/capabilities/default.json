  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-list-pico-volumes",
    "allow-ripple-clip",
    "allow-reorder-clips",
    "allow-insert-wait",
    "allow-pick-import-photos",
    "allow-import-photos",
    "allow-detect-screen-quad",
    "allow-warp-photo",
    "allow-read-photo-bytes",
    "allow-create-project",
    "allow-load-project",
    "allow-save-project",
    "allow-duplicate-project",
    "allow-export-sequence",
    "allow-write-sequence-file",
    "allow-get-firmware-manifest",
    "allow-flash-uf2",
    "allow-wait-for-volume",
    "allow-write-circuitpy",
    "allow-write-sequence-only",
    "allow-eject-volume"
